<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRÁCTICA 4"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3949AB"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controles avanzados en Android"
            android:textSize="16sp"
            android:textColor="#616161"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Tipo de actividad"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/spinnerActividad"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#3949AB"
            android:popupBackground="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Prioridad"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <RadioGroup
            android:id="@+id/radioGroupPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioBaja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baja"
                android:textColor="#212121"
                android:buttonTint="#3949AB" />

            <RadioButton
                android:id="@+id/radioMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media"
                android:textColor="#212121"
                android:buttonTint="#3949AB"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioAlta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alta"
                android:textColor="#212121"
                android:buttonTint="#3949AB" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Recursos necesarios"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <CheckBox
            android:id="@+id/checkInternet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceso a Internet"
            android:textColor="#212121"
            android:buttonTint="#3949AB" />

        <CheckBox
            android:id="@+id/checkComputadora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Computadora"
            android:textColor="#212121"
            android:buttonTint="#3949AB" />

        <CheckBox
            android:id="@+id/checkMaterial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Material de apoyo"
            android:textColor="#212121"
            android:buttonTint="#3949AB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Notificaciones"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="12dp" />

        <Switch
            android:id="@+id/switchNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar notificaciones"
            android:textColor="#212121"
            android:checked="true"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Progreso: 50%"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/seekBarProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="#3949AB"
            android:thumbTint="#3949AB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6. Fecha de la actividad"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="16dp" />

        <DatePicker
            android:id="@+id/datePickerActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:calendarViewShown="false"
            android:datePickerMode="spinner"
            android:spinnersShown="true"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7. Hora de la actividad"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="16dp" />

        <TimePicker
            android:id="@+id/timePickerActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:background="#FFFFFF" />

        <Button
            android:id="@+id/btnProcesar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROCESAR INFORMACIÓN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#3949AB"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen de la actividad"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3949AB"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa el formulario y presiona el botón."
            android:textSize="15sp"
            android:textColor="#212121"
            android:background="#F1F5F9"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
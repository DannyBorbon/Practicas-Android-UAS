<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRÁCTICA 5"
            android:textColor="#80CBC4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis preferencias"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guarda tus datos y recupéralos cuando vuelvas a abrir la aplicación."
            android:textColor="#BDBDBD"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre completo"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#80CBC4"
            android:hint="Escribe tu nombre"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#80CBC4"
            android:hint="ejemplo@correo.com"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña de prueba"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#80CBC4"
            android:hint="Escribe una contraseña"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="26dp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar datos"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#121212"
            android:backgroundTint="#80CBC4"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCargar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cargar datos"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBorrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Borrar datos guardados"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8E3030"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: listo para comenzar"
            android:textColor="#80CBC4"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
